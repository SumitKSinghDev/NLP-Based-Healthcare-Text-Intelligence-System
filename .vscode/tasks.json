{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start Server (run_app.py)",
      "type": "shell",
      "command": "python",
      "args": ["run_app.py"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Run Pytest Suite",
      "type": "shell",
      "command": "python",
      "args": ["run_tests.py"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "⚡ Rebuild All (Data + Frontend)",
      "type": "shell",
      "command": "python",
      "args": ["run_full_rebuild.py"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "🎨 Recompile Frontend Only",
      "type": "shell",
      "command": "npm.cmd run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
